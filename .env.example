# API Server
ADMIN_SECRET=your-admin-secret-here
SERVER_NAME=NoteColab
# Comma-separated web origins allowed by CORS (Obsidian is always allowed)
CORS_ORIGINS=https://your-domain.com
# Public origin used by the web frontend and smoke checks
PUBLIC_URL=https://your-domain.com
# Hostname only, used by the portable public Compose/Caddy deployment
SITE_HOST=your-domain.com
# Host storage mounted into the API container
NOTECOLAB_DATA_PATH=./data

# --- Access control (all optional; defaults keep the server fully open) ---
# REGISTRATION: open (default) | invite | closed
#   open   — anyone can self-register (the reference server; quota'd usage).
#   invite — /api/v1/auth/register requires REGISTRATION_SECRET; the plugin prompts for it.
#   closed — self-registration disabled; provision users via the admin API.
REGISTRATION=open
# Shared invite code required when REGISTRATION=invite (unset ⇒ invite mode rejects all).
REGISTRATION_SECRET=
# Optional account sign-in providers. A provider is advertised only when its
# client ID, client secret, and the fixed public callback origin are all set.
# Register callbacks as:
#   <OAUTH_CALLBACK_ORIGIN>/api/v1/auth/oauth/callback/google
#   <OAUTH_CALLBACK_ORIGIN>/api/v1/auth/oauth/callback/github
OAUTH_CALLBACK_ORIGIN=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Require a valid per-user API key on the WebSocket upgrade (Yjs relay + signaling).
# Set to true for a completely private instance so /ws/* isn't reachable by strangers.
WS_REQUIRE_AUTH=false
# Connection limits
MAX_WS_CONNECTIONS=200
MAX_WS_PER_ROOM=20
MAX_SIGNAL_CONNECTIONS=200
# One-time grace period applied when legacy short invite tokens are migrated
INVITE_LEGACY_GRACE_DAYS=30

# Storage quotas (bytes). Set FREE_PLAN_BYTES=0 for unlimited (no quota / billing).
FREE_PLAN_BYTES=10485760    # 10 MB
PRO_PLAN_BYTES=536870912    # 0.5 GB

# Billing (optional paid tier — leave BILLING_ENABLED off to disable entirely).
# See docs/SELF-HOSTING.md#billing for the full flow.
BILLING_ENABLED=false
PRO_PLAN_PRICE=€5 / year
PRO_PLAN_DURATION_DAYS=365
# Payment link opened on upgrade; server appends ?client_reference_id=<uid>
BILLING_CHECKOUT_URL=
# Shared secret the payment webhook must present (unset = webhook disabled)
BILLING_WEBHOOK_SECRET=
# Stripe endpoint signing secret for /api/v1/billing/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# APP_UID and APP_GID are normally supplied on the docker compose command line:
# APP_UID=$(id -u) APP_GID=$(id -g) docker compose up ...
